set(NEKO_CHANGELOG_MD "${CMAKE_SOURCE_DIR}/changelog.md")
set(NEKO_CHANGELOG_SRC "${CMAKE_BINARY_DIR}/debian/changelog")
file(REMOVE "${NEKO_CHANGELOG_SRC}")

find_package(Git QUIET)

function(neko_git result)
  set(${result} "" PARENT_SCOPE)
  if(NOT GIT_EXECUTABLE)
    return()
  endif()
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" ${ARGN}
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    OUTPUT_VARIABLE git_out
    ERROR_QUIET
    RESULT_VARIABLE git_rc
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(git_rc EQUAL 0)
    set(${result} "${git_out}" PARENT_SCOPE)
  endif()
endfunction()

function(neko_protect var)
  set(text "${${var}}")
  string(REPLACE ";" "<SEMI>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

function(neko_restore var)
  set(text "${${var}}")
  string(REPLACE "<SEMI>" ";" text "${text}")
  string(REPLACE "<LB>" "[" text "${text}")
  string(REPLACE "<RB>" "]" text "${text}")
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

if(EXISTS "${NEKO_CHANGELOG_MD}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NEKO_CHANGELOG_MD}")
  file(TIMESTAMP "${NEKO_CHANGELOG_MD}" NEKO_MD_DATE "%a, %d %b %Y %H:%M:%S +0000" UTC)
  file(READ "${NEKO_CHANGELOG_MD}" NEKO_MD_TEXT)
  string(REPLACE "\r" "" NEKO_MD_TEXT "${NEKO_MD_TEXT}")
  neko_protect(NEKO_MD_TEXT)
  string(REPLACE "\n" ";" NEKO_MD_LINES "${NEKO_MD_TEXT}")

  set(NEKO_VERSIONS "")
  set(NEKO_INDEX -1)
  foreach(line IN LISTS NEKO_MD_LINES)
    string(STRIP "${line}" line)
    if(line MATCHES "^#+ *[vV]?([0-9][^ ]*)")
      math(EXPR NEKO_INDEX "${NEKO_INDEX} + 1")
      list(APPEND NEKO_VERSIONS "${CMAKE_MATCH_1}")
      set(NEKO_MD_BULLETS_${NEKO_INDEX} "")
    elseif(NEKO_INDEX GREATER_EQUAL 0 AND line MATCHES "^[-*] +(.+)")
      string(APPEND NEKO_MD_BULLETS_${NEKO_INDEX} "  * ${CMAKE_MATCH_1}\n")
    endif()
  endforeach()

  list(LENGTH NEKO_VERSIONS NEKO_TOTAL)
  if(NEKO_TOTAL GREATER 0)
    math(EXPR NEKO_LAST "${NEKO_TOTAL} - 1")

    foreach(i RANGE ${NEKO_LAST})
      list(GET NEKO_VERSIONS ${i} ver)
      set(NEKO_SHA_${i} "")
      foreach(prefix "v" "")
        if("${NEKO_SHA_${i}}" STREQUAL "")
          neko_git(sha rev-parse -q --verify "refs/tags/${prefix}${ver}^{commit}")
          set(NEKO_SHA_${i} "${sha}")
        endif()
      endforeach()
    endforeach()

    set(NEKO_DEB_CHANGELOG "")
    foreach(i RANGE ${NEKO_LAST})
      list(GET NEKO_VERSIONS ${i} ver)
      set(sha "${NEKO_SHA_${i}}")
      set(bullets "${NEKO_MD_BULLETS_${i}}")
      set(date "${NEKO_MD_DATE}")

      if(NOT "${sha}" STREQUAL "")
        neko_git(commit_date log -1 "--format=%cD" "${sha}")
        if(NOT "${commit_date}" STREQUAL "")
          set(date "${commit_date}")
        endif()

        math(EXPR older "${i} + 1")
        set(range "${sha}")
        set(use_git TRUE)
        if(older LESS NEKO_TOTAL)
          if("${NEKO_SHA_${older}}" STREQUAL "")
            set(use_git FALSE)
          else()
            set(range "${NEKO_SHA_${older}}..${sha}")
          endif()
        endif()

        if(use_git)
          neko_git(subjects log --no-merges "--format=%s" "${range}")
          neko_protect(subjects)
          if(NOT "${subjects}" STREQUAL "")
            set(bullets "")
            string(REPLACE "\n" ";" subject_list "${subjects}")
            foreach(subject IN LISTS subject_list)
              string(STRIP "${subject}" subject)
              if(NOT "${subject}" STREQUAL "")
                string(APPEND bullets "  * ${subject}\n")
              endif()
            endforeach()
          endif()
        endif()
      endif()

      if("${bullets}" STREQUAL "")
        set(bullets "  * Release ${ver}.\n")
      endif()
      string(APPEND NEKO_DEB_CHANGELOG "nekodrome (${ver}) unstable; urgency=medium\n\n${bullets}\n -- ${NEKO_MAINTAINER}  ${date}\n\n")
    endforeach()

    neko_restore(NEKO_DEB_CHANGELOG)
    string(STRIP "${NEKO_DEB_CHANGELOG}" NEKO_DEB_CHANGELOG)
    file(WRITE "${NEKO_CHANGELOG_SRC}" "${NEKO_DEB_CHANGELOG}\n")
  endif()
endif()
